{
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.test.ts",
    "**/*.test.js",
    "**/__tests__/**",
    "**/__snapshots__/**",
    "**/tests/**",
    "**/.turbo/**"
  ],
  "include": [
    "**/src/**/*.ts",
    "**/src/**/*.js"
  ],
  "reporter": ["text", "html", "lcov"],
  "lines": 80,
  "functions": 80,
  "branches": 80,
  "statements": 80,
  "check-coverage": true,
  "all": true
}
